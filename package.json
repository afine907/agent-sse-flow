{
  "name": "agent-sse-flow",
  "version": "3.0.0",
  "packageManager": "pnpm@10.8.1",
  "description": "Agent SSE Stream Visualizer - A lightweight React component. Free, unlimited, local.",
  "sideEffects": false,
  "main": "dist/agent-sse-flow.cjs.js",
  "module": "dist/agent-sse-flow.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/agent-sse-flow.es.js",
      "require": "./dist/agent-sse-flow.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:demo": "vite build --config vite.demo.config.ts",
    "mock-server": "node src/mock-server/index.mjs",
    "perf-test": "playwright test tests/perf.spec.ts",
    "visual-test": "playwright test tests/visual.spec.ts --update-snapshots",
    "lighthouse-test": "playwright test tests/lighthouse.spec.ts",
    "benchmark": "vitest run --config vitest.benchmark.config.ts",
    "dev-storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "keywords": [
    "agent",
    "sse",
    "flow",
    "visualization",
    "streaming",
    "react",
    "langgraph",
    "langchain",
    "langsmith-alternative"
  ],
  "author": "afine907",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afine907/agent-sse-flow.git"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semantic-release": "^25.0.3",
    "storybook": "^10.4.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "react-markdown": "^10.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
